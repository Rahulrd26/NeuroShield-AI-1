{
  "dataset": "NSL-KDD",
  "version": "1.0",
  "classes": ["Normal", "DoS", "Probe", "R2L", "U2R"],
  "class_descriptions": {
    "Normal": "Legitimate, benign network traffic adhering to RFC protocols.",
    "DoS": "Denial of Service (e.g., Neptune SYN flood, Smurf, Pod, Teardrop) attempting to exhaust computing/network resources.",
    "Probe": "Surveillance / Scanning (e.g., Portsweep, Ipsweep, Nmap, Satan) mapping network topology and open vulnerabilities.",
    "R2L": "Remote to Local (e.g., Guess_Passwd, Warezclient, Imap, Phf) unauthorized access over network into user space.",
    "U2R": "User to Root (e.g., Buffer_Overflow, Rootkit, Loadmodule) local privilege escalation gaining root/admin shell."
  },
  "top_10_features": [
    {
      "key": "src_bytes",
      "label": "Source Bytes",
      "type": "number",
      "default": 232,
      "min": 0,
      "max": 1000000,
      "unit": "bytes",
      "importance_rank": 1,
      "impact": "High payload from source to destination; excessive byte surges often indicate data exfiltration, buffer overflow payloads, or flood attacks.",
      "category": "Basic Connection"
    },
    {
      "key": "dst_bytes",
      "label": "Destination Bytes",
      "type": "number",
      "default": 8153,
      "min": 0,
      "max": 1000000,
      "unit": "bytes",
      "importance_rank": 2,
      "impact": "Data transferred from destination back to source. Asymmetric zero-return flows are characteristic of SYN flooding.",
      "category": "Basic Connection"
    },
    {
      "key": "count",
      "label": "Connection Count (Past 2s)",
      "type": "number",
      "default": 3,
      "min": 0,
      "max": 512,
      "unit": "connections",
      "importance_rank": 3,
      "impact": "Number of connections to the same destination host in the past 2 seconds. A massive spike (e.g. >100) indicates DoS flooding or scanning.",
      "category": "Time-based Traffic"
    },
    {
      "key": "serror_rate",
      "label": "SYN Error Rate (serror)",
      "type": "number",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "unit": "ratio (0-1)",
      "importance_rank": 4,
      "impact": "Percentage of connections that activated SYN error flags (S0, S1, S2, S3). High values (>0.8) strongly signal SYN flood (Neptune) attacks.",
      "category": "Time-based Traffic"
    },
    {
      "key": "same_srv_rate",
      "label": "Same Service Rate",
      "type": "number",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "unit": "ratio (0-1)",
      "importance_rank": 5,
      "impact": "Percentage of connections to the same service. Low values with high connection count indicate horizontal port scanning.",
      "category": "Time-based Traffic"
    },
    {
      "key": "diff_srv_rate",
      "label": "Different Service Rate",
      "type": "number",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "unit": "ratio (0-1)",
      "importance_rank": 6,
      "impact": "Percentage of connections to different services on the destination. High rates are typical of automated port sweeps.",
      "category": "Time-based Traffic"
    },
    {
      "key": "dst_host_srv_count",
      "label": "Dst Host Service Count",
      "type": "number",
      "default": 255,
      "min": 0,
      "max": 255,
      "unit": "connections",
      "importance_rank": 7,
      "impact": "Number of connections having the same service as current connection among previous 100 connections to the destination host.",
      "category": "Host-based Traffic"
    },
    {
      "key": "logged_in",
      "label": "Logged In Flag",
      "type": "select",
      "default": 1,
      "options": [
        {"value": 1, "label": "1 - Successfully Logged In"},
        {"value": 0, "label": "0 - Not Logged In / Handshake Failed"}
      ],
      "importance_rank": 8,
      "impact": "1 if successfully authenticated. Failed authentication with repeated connection bursts often points to brute-force R2L attacks.",
      "category": "Content Feature"
    },
    {
      "key": "protocol_type",
      "label": "Protocol Type",
      "type": "select",
      "default": "tcp",
      "options": [
        {"value": "tcp", "label": "TCP (Transmission Control Protocol)"},
        {"value": "udp", "label": "UDP (User Datagram Protocol)"},
        {"value": "icmp", "label": "ICMP (Internet Control Message Protocol)"}
      ],
      "importance_rank": 9,
      "impact": "Transport layer protocol. Smurf attacks utilize ICMP echo broadcasts, whereas Neptune relies on TCP SYN packets.",
      "category": "Basic Connection"
    },
    {
      "key": "service",
      "label": "Target Service",
      "type": "select",
      "default": "http",
      "options": [
        {"value": "http", "label": "http - Web Service (Port 80/443)"},
        {"value": "private", "label": "private - Non-standard Private Ports"},
        {"value": "domain_u", "label": "domain_u - DNS Queries (Port 53)"},
        {"value": "smtp", "label": "smtp - Mail Transfer (Port 25)"},
        {"value": "ftp_data", "label": "ftp_data - FTP File Transfer"},
        {"value": "ftp", "label": "ftp - FTP Control (Port 21)"},
        {"value": "telnet", "label": "telnet - Remote Shell (Port 23)"},
        {"value": "finger", "label": "finger - User Finger Service"},
        {"value": "eco_i", "label": "eco_i - ICMP Echo Ping"},
        {"value": "ecr_i", "label": "ecr_i - ICMP Echo Reply"},
        {"value": "other", "label": "other - Unclassified Ports"}
      ],
      "importance_rank": 10,
      "impact": "Target application service. Attacks frequently target vulnerable daemons or utilize private high-ports for C2 beaconing.",
      "category": "Basic Connection"
    }
  ],
  "categorical_options": {
    "protocol_type": ["tcp", "udp", "icmp"],
    "service": [
      "http", "private", "domain_u", "smtp", "ftp_data", "other",
      "eco_i", "telnet", "finger", "ftp", "ecr_i", "ssh", "auth",
      "time", "courier", "discard", "domain", "echo", "harvest",
